<?xml version="1.0" encoding="UTF-8"?>
<!--
  flexui-rs 全控件 XML 布局示例：
  覆盖 VBox/HBox/Box(Panel)/Label/Button(4 状态)/CheckBox/Radio+group/TabBox/Edit/Image。
  事件响应由示例代码按 name 挂接（见 showcase.rs）：按钮点击/复选切换/启用禁用会更新 status 标签，
  Radio 切换驱动 TabBox 翻页，Edit 可键入。$ASSETS 由代码替换为示例资源目录绝对路径。
-->
<VBox spacing="12" padding="16" normal-bgcolor="#1A1C22">

  <Label text="flexui-rs · 全控件总览（XML 布局 + 事件响应）" height="26" normal-fgcolor="#FFFFFF" bold="true" font-size="16"/>

  <!-- 字体样式 + 省略号（窄宽 Label 超宽自动截断） -->
  <HBox spacing="16" height="22">
    <Label text="粗体" normal-fgcolor="#E6EBF5" bold="true" width="60"/>
    <Label text="斜体" normal-fgcolor="#E6EBF5" italic="true" width="60"/>
    <Label text="下划线" normal-fgcolor="#E6EBF5" underline="true" width="70"/>
    <Label text="这是一段很长会被省略号截断的文本示例" normal-fgcolor="#8FA0C0" width="160"/>
  </HBox>

  <!-- 状态栏：被各控件的事件更新 -->
  <Label name="status" text="状态：等待交互…（点击按钮 / 勾选 / 切页 / 在输入框打字）"
         height="24" normal-fgcolor="#8FE3A0"/>

  <!-- 按钮组：完整 4 状态样式 -->
  <HBox spacing="10" height="44">
    <Button name="btnPrimary" text="主要按钮" width="120" height="40" tooltip="这是主要操作按钮（悬停约 0.5s 显示）"
            normal-bgcolor="#3478F6" hot-bgcolor="#4A8CFF" pushed-bgcolor="#2A5FD0"
            disabled-bgcolor="#5A5F6B" normal-fgcolor="#FFFFFF" corner-radius="8"/>
    <Button name="btnGhost" text="次要按钮" width="120" height="40"
            normal-bgcolor="#2A2E38" hot-bgcolor="#353A46" pushed-bgcolor="#20242C"
            normal-fgcolor="#E6EBF5" border-width="1" normal-bordercolor="#3A4050" corner-radius="8"/>
    <Button name="btnToggle" text="禁用/启用主要按钮" width="170" height="40"
            normal-bgcolor="#7A5AF0" hot-bgcolor="#8B6BFF" pushed-bgcolor="#5F45C8"
            normal-fgcolor="#FFFFFF" corner-radius="8"/>
  </HBox>

  <!-- 下拉框（ComboBox）：点击弹出选项菜单，选中回填 -->
  <HBox spacing="12" height="34">
    <Label text="主题：" width="50" height="26" normal-fgcolor="#E6EBF5"/>
    <ComboBox name="theme" options="深色,浅色,跟随系统" selected="0" width="140" height="30"
              normal-bgcolor="#20242C" normal-fgcolor="#E6EBF5"
              border-width="1" normal-bordercolor="#4A5064" corner-radius="6"
              tooltip="选择界面主题"/>
  </HBox>

  <!-- 复选框 -->
  <HBox spacing="24" height="28">
    <CheckBox name="chkRemember" text="记住我" height="24" normal-fgcolor="#E6EBF5"/>
    <CheckBox name="chkNews" text="订阅通知" checked="true" height="24" normal-fgcolor="#E6EBF5"/>
  </HBox>

  <!-- 单选（tabbar 标签，绑定 group=1） -->
  <HBox spacing="8" height="26">
    <Radio group="1" tab-index="0" selected="true" text="页面一" width="90" height="24" normal-fgcolor="#E6EBF5"/>
    <Radio group="1" tab-index="1" text="页面二" width="90" height="24" normal-fgcolor="#E6EBF5"/>
    <Radio group="1" tab-index="2" text="页面三" width="90" height="24" normal-fgcolor="#E6EBF5"/>
  </HBox>

  <!-- 多页容器：与 group=1 的 radio 绑定 -->
  <TabBox bindgroup="1" flex="1">
    <!-- padding 简写：纵 20 / 横 40（内容区四周非对称留白）；margin 简写：上 8 其余 0 -->
    <Box normal-bgcolor="#2C3E5A" corner-radius="10" padding="20 40" margin="8 0 0 0">
      <Label text="第一页 · Box 叠放容器（padding=纵20/横40 简写演示）"
             normal-fgcolor="#FFFFFF" normal-textalign="center"/>
    </Box>

    <VBox normal-bgcolor="#3C3054" corner-radius="10" padding="14" spacing="10">
      <Label text="第二页 · VBox + Image + Edit" normal-fgcolor="#FFFFFF"/>
      <HBox spacing="12" height="52">
        <Image src="logo.bmp" width="48" height="48"/>
        <Image src="icon.svg" width="48" height="48"/>
        <Image src="icon.svg" width="48" height="48" normal-fgtint="#FF9900"/>
        <Edit name="edit1" text="在这里输入…" flex="1" height="32"
              normal-bgcolor="#20242C" normal-fgcolor="#FFFFFF"
              border-width="1" normal-bordercolor="#4A5064" corner-radius="6"/>
      </HBox>
      <Edit name="edit_multi" multiline="true" height="90"
            normal-bgcolor="#20242C" normal-fgcolor="#FFFFFF"
            border-width="1" normal-bordercolor="#4A5064" corner-radius="6"/>
      <!-- P1 新控件：分隔条 / 滑块 / 进度条 -->
      <Separator normal-bgcolor="#4A5064"/>
      <Label text="Slider（拖动）与 Progress" height="20" normal-fgcolor="#C8D0E0"/>
      <Slider name="vol" value="0.4" height="24"
              normal-bgcolor="#20242C" normal-fgcolor="#3478F6"/>
      <Progress name="prog" value="0.65" height="8"
                normal-bgcolor="#20242C" normal-fgcolor="#8FE3A0"/>
    </VBox>

    <Box normal-bgcolor="#2C4A3E" corner-radius="10">
      <Label text="第三页 · 命中穿透 / 状态机由样式驱动"
             normal-fgcolor="#FFFFFF" normal-textalign="center"/>
    </Box>
  </TabBox>

</VBox>
