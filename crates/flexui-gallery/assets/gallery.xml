<?xml version="1.0" encoding="UTF-8"?>
<Window title="FlexUI Gallery" width="920" height="640" min-width="760" min-height="520"
        resizable="true" titlebar="system">
  <VBox name="root" width="fill" height="fill">
    <HBox height="58" padding="20 14" align="center" bgcolor="@surface"
          bordercolor="@border-light" borderwidth="1">
      <Label text-verbatim="FlexUI Gallery" width="fill" font-size="20" bold="true"
             fgcolor="@text-primary"/>
      <Label text-verbatim="Dark mode" width="84" fgcolor="@text-secondary"/>
      <CheckBox name="theme_switch" switch="true" width="48" height="26"
                bgcolor="@border" selected-bgcolor="@brand" thumbcolor="@surface"/>
    </HBox>
    <HBox width="fill" height="fill">
      <VBox width="176" height="fill" padding="12" spacing="6" bgcolor="@surface"
            bordercolor="@border-light" borderwidth="1">
        <Radio name="nav_basic" text-verbatim="Basic" group="1" tab-index="0" selected="true"
               indicator="false" variant="nav" height="40"/>
        <Radio name="nav_forms" text-verbatim="Forms" group="1" tab-index="1"
               indicator="false" variant="nav" height="40"/>
        <Radio text-verbatim="Data" group="1" tab-index="2"
               indicator="false" variant="nav" height="40"/>
        <Radio text-verbatim="States" group="1" tab-index="3"
               indicator="false" variant="nav" height="40"/>
      </VBox>
      <TabBox name="pages" bindgroup="1" width="fill" height="fill">
        <Include src="pages/basic.xml"/>
        <Include src="pages/forms.xml"/>
        <Include src="pages/data.xml"/>
        <Include src="pages/states.xml"/>
      </TabBox>
    </HBox>
  </VBox>
</Window>
