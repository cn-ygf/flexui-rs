<?xml version="1.0" encoding="UTF-8"?>
<Window title="FlexUI Gallery" width="920" height="640" min-width="760" min-height="520"
        resizable="true" titlebar="system">
  <VBox name="root" width="fill" height="fill">
    <HBox height="64" padding="20 14" spacing="8" align="center" bgcolor="@surface"
          bordercolor="@border-light" borderwidth="1">
      <Label text-verbatim="FlexUI Gallery" width="fill" font-size="20" bold="true"
             fgcolor="@text-primary"/>
      <Panel width="18" height="18" bgcolor="#FB7299" corner-radius="4" mouse="transparent"/>
      <Button name="apply_bilibili_theme" class="theme-action" variant="primary"
              text-verbatim="Bilibili Pink" width="116" height="36"
              normal-bgcolor="#FB7299" hot-bgcolor="#FC8BAB" pushed-bgcolor="#E2527B"
              normal-bordercolor="#FB7299" hot-bordercolor="#FC8BAB" pushed-bordercolor="#E2527B"
              normal-fgcolor="#FFFFFF" corner-radius="6"/>
      <Button name="restore_default_theme" class="theme-action"
              text-verbatim="Default" width="88" height="36"/>
      <Label text-verbatim="Dark" width="40" fgcolor="@text-secondary"/>
      <Switch name="theme_switch" width="48" height="26" thumbcolor="@surface"/>
    </HBox>
    <HBox width="fill" height="fill">
      <VBox width="176" height="fill" padding="12" spacing="6" bgcolor="@surface"
            bordercolor="@border-light" borderwidth="1">
        <Radio name="nav_basic" text-verbatim="Basic" group="1" tab-index="0" selected="true"
               indicator="false" variant="nav" height="40"/>
        <Radio name="nav_forms" text-verbatim="Forms" group="1" tab-index="1"
               indicator="false" variant="nav" height="40"/>
        <Radio text-verbatim="Data" group="1" tab-index="2"
               indicator="false" variant="nav" height="40"/>
        <Radio text-verbatim="States" group="1" tab-index="3"
               indicator="false" variant="nav" height="40"/>
        <Radio text-verbatim="Native Menu" group="1" tab-index="4"
               indicator="false" variant="nav" height="40"/>
        <Radio name="nav_async" text-verbatim="Async HTTP" group="1" tab-index="5"
               indicator="false" variant="nav" height="40"/>
      </VBox>
      <TabBox name="pages" bindgroup="1" width="fill" height="fill">
        <Include src="pages/basic.xml"/>
        <Include src="pages/forms.xml"/>
        <Include src="pages/data.xml"/>
        <Include src="pages/states.xml"/>
        <Include src="pages/native_menu.xml"/>
        <Include src="pages/async_http.xml"/>
      </TabBox>
    </HBox>
  </VBox>
</Window>
